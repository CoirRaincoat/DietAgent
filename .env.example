DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
# Opt-in paid tofu proposal calls. A parser key alone does not enable this.
# Keep false unless billing/data scope is separately authorized for deployment.
ALLOW_RECIPE_GENERATION=false
SESSION_DB=runtime/sessions.sqlite3

# Optional native local official profiles. Source IDs must be integers 1-50.
# Keep the profile file outside the repository. Only user text/allowlisted intent
# fields reach the model; profiles, recipes and explanations stay local.
# LOCAL_PROFILE_PATH=C:/local-private/profiles.json
# Optional Compose override uses LOCAL_PROFILE_HOST_PATH instead; see docs/LOCAL_OFFICIAL_IDS.md.

# Optional independent OpenAI-compatible evaluator.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_TIMEOUT_SECONDS=90
